#! /bin/sh
exec nawk '
BEGIN {FS="	"}
$1 != "" {group[$1] = $0 }
END {
	if (lookup != "") {
		nl = split(lookup,glist,",")
		for(i=1;i<=nl;i++) {
			printf("%s\n",group[glist[i]]);
		}
	}
}
