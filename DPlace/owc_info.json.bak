        },
        {
            "id": "oi08",
            "hsla": "hsla(242.31,95.35%,83.47%,0.770)",
            "description": "The term Aranda refers to a language group that is made up of at least eleven dialects, the speakers of which constitute separate cultural communities who live or lived in the central Australian desert. These groups were independent of each other and had no sense of common identity. Relations between Aranda groups have varied from friendship, alliance, and intermarriage on the one hand, to enmity and hostility on the other.  Today the Aranda groups are either extinct or have become assimilated.",
            "highest_bt": "Oceania",
            "bt": "Australia",
            "subsistence_type": "hunter-gatherers",
            "docs": 47,
            "hasSummary": true,
