        {
            "id": "nt13",
            "hsla": "hsla(21.46,95.25%,81.95%,0.820)",
            "description": "The Navajo are the second largest Native North American group. They currently live mostly in northwestern New Mexico, northeastern Arizona, and southeastern Utah. The Navajo language belongs to the Apachean branch of the Athapaskan family. Ancestors of the Navajo are thought to have migrated to the Southwest within the last one thousand years. Modern Navajo culture exhibits a unique blend of Athapaskan, Puebloan, Mexican, and Anglo-American influences. Every Navajo belongs to one of sixty-four matrilineal clans. Navajo mythology is epitomized in the curing ceremony called the Blessing Way.",
            "highest_bt": "North America",
            "bt": "Southwest and Basin",
            "subsistence_type": "agro-pastoralists",
            "docs": 251,
            "hasSummary": true,
            "ocms": [],
            "hl": {},
            "term": "Navajo"
        },
        {
            "id": "sr14",
            "hsla": "hsla(355.21,95.26%,81.71%,0.810)",
            "description": "The Ndyuka live in the northern extension of the Amazonian rain forest in the Marowijne (Maroni) river basin which is shared by the Republic of Suriname and French Guiana. The Ndyuka are one of six Maroon (or &#x22;Bush Negro&#x22;) groups in Suriname.  Maroons are the descendants of rebel African slaves who succeeded in building independent communities in the Americas. After a protracted guerrilla war, they concluded a peace treaty with the Dutch colonial regime in 1760 and were granted semi-independence. Ndyuka economy has always been based on swidden agriculture, supplemented by hunting and fishing, and participation in the postcolonial economy.",
            "highest_bt": "South America",
            "bt": "Amazon and Orinoco",
            "subsistence_type": "horticulturalists",
            "docs": 17,
            "hasSummary": true,
