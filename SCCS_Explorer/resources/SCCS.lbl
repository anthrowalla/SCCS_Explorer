#! /bin/sh
exec nawk '
BEGIN {cval=""}	
 cval == "" && $1 != "" {
		cval = $1;$1 = "";split($0,lab,"(");
		varlable[cval] = lab[1]; next}
 cval != "" && $1 != "" {
		vval = $1; $1 = ""
		varvals[cval "," vval] = $0
		next;
	}
cval != "" && $1 == "" {cval = "";next}
END {
	if (lookup == "") {
		nl = split(vbar,lab," ")
		for(i=1;i<=nl;i++) {
			if (i > 1) printf(",");
			printf(varlable[lab[i]"."]);
		}
		printf("\n");
	} else {
		nl = split(lookup,lab," ")
		for(i=1;i<=nl;i++) {
			if (i > 1) printf(",");
			printf(varvals[vbar".,"lab[i]]);
		}
		printf("\n");
	}
}
'	  vbar="$1" lookup="$2"  <<EOF
